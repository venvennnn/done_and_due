# Copy to .env.local for local development. Leave values empty to run the public demo.
# Never commit filled secrets. Live PayPal is not supported in this release.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local

# Supabase (required only for /app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (server only; required only when transcribing or extracting in /app)
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.8-flash

# PayPal Sandbox only. Any other PAYPAL_ENV is rejected.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_WORKSPACE_ID=

# Comma-separated contractor emails allowed to invoice from this deployment.
CONTRACTOR_EMAIL_ALLOWLIST=
